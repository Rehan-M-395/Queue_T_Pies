GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://YOUR_BACKEND_HOST/api/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=
